{
  "name": "@resolve-ai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:render": "prisma migrate deploy --config prisma.config.ts && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@nlpjs/core": "4.26.1",
    "@nlpjs/lang-en": "4.26.1",
    "@nlpjs/lang-es": "4.26.1",
    "@nlpjs/nlp": "4.27.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@resolve-ai/contracts": "workspace:*",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.0.0",
    "helmet": "^8.1.0",
    "jose": "6.2.15",
    "libsodium-wrappers": "^0.8.4",
    "nodemailer": "10.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.0.0",
    "pg-connection-string": "^2.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/swagger-ui-express": "^4.1.7"
  }
}
