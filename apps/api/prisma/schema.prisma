generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// M09 keeps historical identity references without cascading deletions.
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorKind     String   @default("USER") @map("actor_kind")
  module        String   @default("M01")
  action        String   @default("SETTINGS_UPDATED")
  outcome       String   @default("SUCCEEDED")
  transactionId String?  @map("transaction_id") @db.Uuid
  resourceType  String   @default("MERCHANT") @map("resource_type")
  resourceId    String?  @map("resource_id") @db.Uuid
  durationMs    Int?     @map("duration_ms")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  record        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([merchantId, createdAt, id])
  @@index([merchantId, transactionId, createdAt])
  @@index([merchantId, resourceId, createdAt])
  @@map("audit_events")
}

// Minimal merchant identity anchor. M01 will own its integration and authorization.
model Merchant {
  id                      String               @id @default(uuid()) @db.Uuid
  displayName             String               @map("display_name")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  allowInvestigations     Boolean              @default(false) @map("allow_investigations")
  allowSubmissions        Boolean              @default(false) @map("allow_submissions")
  requireMerchantApproval Boolean              @default(true) @map("require_merchant_approval")
  members                 MerchantMember[]
  paypalAccount           PayPalAccount?
  paymentAdjustments      PaymentAdjustment[]
  integration             MerchantIntegration?
  events                  MerchantEvent[]
  webhookEvents           WebhookEvent[]
  transactions            Transaction[]
  orders                  MerchantOrder[]
  dossiers                EvidenceDossier[]
  verifications           VerificationRun[]
  investigations          InvestigationRun[]
  orderSources            OrderSourceJob[]
  disputes                Dispute[]
  submissions             Submission[]
  subscriptions           Subscription[]
  erpConnections          ErpConnection[]
  externalRecords         ExternalRecord[]
  transactionLinks        TransactionLink[]
  mediationPolicy         MediationPolicy?
  conciliationPolicy      ConciliationPolicy?
  conciliationChats       ConciliationChat[]

  @@map("merchants")
}

// Planes de suscripción. Los precios se configuran en base de datos (no hardcodeados).
model Plan {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(120)
  priceCents           Int      // Precio en centavos de la moneda indicada
  currency             String   @default("USD") @db.VarChar(3)
  interval             String   @db.VarChar(16) // MONTH | YEAR
  maxTransactions      Int?
  maxDisputes          Int?
  includesConciliation Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  subscriptions        Subscription[]

  @@map("plans")
}

// Suscripción activa de un merchant a un plan.
model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  planId            String   @map("plan_id") @db.Uuid
  status            String   @default("ACTIVE") @db.VarChar(32) // ACTIVE | CANCELED | EXPIRED
  currentPeriodEnd  DateTime @map("current_period_end") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan              Plan     @relation(fields: [planId], references: [id])
  merchant          Merchant @relation(fields: [merchantId], references: [id])

  @@map("subscriptions")
}

enum MerchantRole {
  ADMIN
  VIEWER
}

model MerchantMember {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @map("merchant_id") @db.Uuid
  authUserId String       @map("auth_user_id") @db.Uuid
  role       MerchantRole @default(VIEWER)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([authUserId])
  @@map("merchant_members")
}

model MerchantIntegration {
  merchantId            String   @id @map("merchant_id") @db.Uuid
  connectionStatus      String   @map("connection_status")
  disputesReadStatus    String   @map("disputes_read_status")
  credentialFingerprint String   @map("credential_fingerprint")
  lastCheckedAt         DateTime @map("last_checked_at") @db.Timestamptz(3)
  paypalHttpStatus      Int?     @map("paypal_http_status")
  paypalDebugId         String?  @map("paypal_debug_id")
  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("merchant_integrations")
}

model MerchantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  details     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
  @@map("merchant_events")
}

model WebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  merchantId     String        @map("merchant_id") @db.Uuid
  environment    String        @default("sandbox")
  paypalEventId  String        @map("paypal_event_id") @db.VarChar(255)
  eventType      String        @map("event_type") @db.VarChar(128)
  eventCreatedAt DateTime      @map("event_created_at") @db.Timestamptz(3)
  webhookId      String        @map("webhook_id")
  transmissionId String        @map("transmission_id")
  payload        Json
  rawBody        String        @map("raw_body")
  payloadHash    String        @map("payload_hash") @db.VarChar(64)
  rawBodyHash    String        @map("raw_body_hash") @db.VarChar(64)
  paypalResourceId String? @map("paypal_resource_id") @db.VarChar(255)
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  job            IngestionJob?
  transaction    Transaction?
  disputeSource  Dispute?       @relation("DisputeSourceEvent")
  disputeEvents  DisputeEvent[]
  submissionEvents SubmissionEvent[]
  paymentAdjustments PaymentAdjustment[]

  @@unique([merchantId, environment, paypalEventId])
  @@index([merchantId, receivedAt])
  @@index([eventType, paypalResourceId, environment])
  @@map("webhook_events")
}

model IngestionJob {
  id         String       @id @default(uuid()) @db.Uuid
  eventId    String       @unique @map("event_id") @db.Uuid
  kind       String
  status     String       @default("QUEUED")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)
  errorCode  String?      @map("error_code") @db.VarChar(64)
  event      WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("ingestion_jobs")
}

// M03 owns captured payments. References are not merchant order documents.
model Transaction {
  id                     String   @id @default(uuid()) @db.Uuid
  merchantId             String   @map("merchant_id") @db.Uuid
  environment            String   @default("sandbox")
  paypalCaptureId        String   @map("paypal_capture_id") @db.VarChar(255)
  paypalOrderId          String?  @map("paypal_order_id") @db.VarChar(255)
  merchantOrderReference String?  @map("merchant_order_reference") @db.VarChar(255)
  invoiceId              String?  @map("invoice_id") @db.VarChar(255)
  status                 String   @default("COMPLETED")
  returnedAmount         Decimal @default(0) @map("returned_amount") @db.Decimal(38, 8)
  adjustmentReviewRequired Boolean @default(false) @map("adjustment_review_required")
  currencyCode           String   @map("currency_code") @db.VarChar(3)
  amount                 Decimal  @db.Decimal(24, 8)
  capturedAt             DateTime @map("captured_at") @db.Timestamptz(3)
  sourceEventId          String   @unique @map("source_event_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  merchantOrderId        String?  @unique @map("merchant_order_id") @db.Uuid
  orderLinkError         String?  @map("order_link_error") @db.VarChar(64)

  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sourceEvent    WebhookEvent       @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  merchantOrder  MerchantOrder?     @relation(fields: [merchantOrderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  dossier        EvidenceDossier?
  verifications  VerificationRun[]
  investigations InvestigationRun[]
  orderSources   OrderSourceJob[]
  shipmentTrackingJob ShipmentTrackingJob?
  shipmentTrackingSnapshots ShipmentTrackingSnapshot[]
  disputes       Dispute[]

  @@unique([merchantId, environment, paypalCaptureId])
  @@unique([merchantOrderId, merchantId])
  @@unique([id, merchantId])
  @@index([merchantId, createdAt, id])
  @@map("transactions")
}

// M03 owns immutable refund/reversal movements, including those received before a capture.
model PaymentAdjustment {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  environment String @default("sandbox")
  paypalCaptureId String @map("paypal_capture_id") @db.VarChar(255)
  paypalAdjustmentId String @map("paypal_adjustment_id") @db.VarChar(255)
  kind String
  currencyCode String @map("currency_code") @db.VarChar(3)
  amount Decimal @db.Decimal(24, 8)
  cumulativeReturnedAmount Decimal? @map("cumulative_returned_amount") @db.Decimal(24, 8)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  sourceEventId String @unique @map("source_event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sourceEvent WebhookEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, environment, paypalAdjustmentId], map: "payment_adjustments_merchant_env_adjustment_key")
  @@index([merchantId, environment, paypalCaptureId], map: "payment_adjustments_merchant_env_capture_idx")
  @@map("payment_adjustments")
}

model MerchantOrder {
  id             String       @id @default(uuid()) @db.Uuid
  merchantId     String       @map("merchant_id") @db.Uuid
  environment    String       @default("sandbox")
  externalId     String       @map("external_id") @db.VarChar(255)
  paypalOrderId  String?      @map("paypal_order_id") @db.VarChar(255)
  sourceKind     String       @map("source_kind")
  sourceSystem   String       @map("source_system") @db.VarChar(255)
  currencyCode   String       @map("currency_code") @db.VarChar(3)
  totalAmount    Decimal      @map("total_amount") @db.Decimal(24, 8)
  shippingAmount Decimal      @map("shipping_amount") @db.Decimal(24, 8)
  taxAmount      Decimal      @map("tax_amount") @db.Decimal(24, 8)
  discountAmount Decimal      @map("discount_amount") @db.Decimal(24, 8)
  orderedAt      DateTime     @map("ordered_at") @db.Timestamptz(3)
  items          Json
  contentHash    String       @map("content_hash") @db.VarChar(64)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction    Transaction?

  @@unique([merchantId, environment, externalId])
  @@unique([id, merchantId])
  @@unique([merchantId, environment, paypalOrderId])
  @@index([merchantId, createdAt, id])
  @@map("merchant_orders")
}

model EvidenceDossier {
  id            String         @id @default(uuid()) @db.Uuid
  merchantId    String         @map("merchant_id") @db.Uuid
  transactionId String         @unique @map("transaction_id") @db.Uuid
  revision      Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction   Transaction    @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  items         EvidenceItem[]

  @@unique([transactionId, merchantId])
  @@index([merchantId])
  @@map("evidence_dossiers")
}

model EvidenceItem {
  id                String          @id @default(uuid()) @db.Uuid
  dossierId         String          @map("dossier_id") @db.Uuid
  type              String
  logicalKey        String          @map("logical_key") @db.VarChar(64)
  version           Int
  sourceKind        String          @map("source_kind")
  sourceSystem      String          @map("source_system") @db.VarChar(255)
  externalReference String          @map("external_reference") @db.VarChar(255)
  retrievedAt       DateTime        @map("retrieved_at") @db.Timestamptz(3)
  content           Json
  contentHash       String          @map("content_hash") @db.VarChar(64)
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  dossier           EvidenceDossier @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  @@unique([dossierId, version])
  @@index([dossierId, logicalKey, version])
  @@map("evidence_items")
}

// M05 owns investigations; evidence originals remain owned by M04.
model InvestigationRun {
  id               String            @id @default(uuid()) @db.Uuid
  merchantId       String            @map("merchant_id") @db.Uuid
  transactionId    String            @map("transaction_id") @db.Uuid
  idempotencyKey   String            @map("idempotency_key") @db.Uuid
  actorUserId      String            @map("actor_user_id") @db.Uuid
  status           String            @default("RUNNING")
  provider         String
  model            String            @db.VarChar(128)
  promptVersion    String            @map("prompt_version") @db.VarChar(64)
  evidenceRevision Int               @map("evidence_revision")
  snapshot         Json
  snapshotHash     String            @map("snapshot_hash") @db.VarChar(64)
  result           Json?
  resultHash       String?           @map("result_hash") @db.VarChar(64)
  trace            Json
  usage            Json
  errorCode        String?           @map("error_code") @db.VarChar(80)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?         @map("finished_at") @db.Timestamptz(3)
  merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction      Transaction       @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  verifications    VerificationRun[]

  @@unique([merchantId, transactionId, idempotencyKey], map: "investigation_runs_merchant_id_transaction_id_idempotency_key_k")
  @@unique([id, transactionId, merchantId])
  @@index([merchantId, transactionId, createdAt])
  @@map("investigation_runs")
}

// M03 owns source work and normalized current data; M04 owns original history.
model OrderSourceJob {
  id              String      @id @default(uuid()) @db.Uuid
  merchantId      String      @map("merchant_id") @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  providerId      String      @map("provider_id") @db.VarChar(64)
  sourceKind      String      @map("source_kind")
  sourceSystem    String      @map("source_system") @db.VarChar(255)
  status          String      @default("PENDING")
  attempts        Int         @default(0)
  leaseToken      String?     @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?   @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt   DateTime?   @map("next_attempt_at") @db.Timestamptz(3)
  lastCheckedAt   DateTime?   @map("last_checked_at") @db.Timestamptz(3)
  lastSucceededAt DateTime?   @map("last_succeeded_at") @db.Timestamptz(3)
  errorCode       String?     @map("error_code") @db.VarChar(128)
  httpStatus      Int?        @map("http_status")
  evidenceId      String?     @map("evidence_id") @db.Uuid
  normalized      Json?
  contentHash     String?     @map("content_hash") @db.VarChar(64)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction     Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Cascade)

  @@unique([transactionId, providerId])
  @@index([merchantId, status, nextAttemptAt])
  @@map("order_source_jobs")
}

// M06 owns verification runs; M05 remains immutable during verification.
model VerificationRun {
  id               String      @id @default(uuid()) @db.Uuid
  merchantId       String      @map("merchant_id") @db.Uuid
  transactionId    String      @map("transaction_id") @db.Uuid
  investigationId  String      @map("investigation_id") @db.Uuid
  idempotencyKey   String      @map("idempotency_key") @db.Uuid
  actorUserId      String      @map("actor_user_id") @db.Uuid
  status           String      @default("RUNNING")
  provider         String
  model            String      @db.VarChar(128)
  promptVersion    String      @map("prompt_version") @db.VarChar(64)
  evidenceRevision Int         @map("evidence_revision")
  snapshot         Json
  snapshotHash     String      @map("snapshot_hash") @db.VarChar(64)
  result           Json?
  resultHash       String?     @map("result_hash") @db.VarChar(64)
  trace            Json
  usage            Json
  errorCode        String?     @map("error_code") @db.VarChar(80)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?   @map("finished_at") @db.Timestamptz(3)
  merchant         Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction      Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Restrict)

  investigation InvestigationRun @relation(fields: [investigationId, transactionId, merchantId], references: [id, transactionId, merchantId], onDelete: Restrict, map: "verification_runs_investigation_fkey")

  @@unique([merchantId, investigationId, idempotencyKey], map: "verification_runs_idempotency_key")
  @@index([merchantId, transactionId, createdAt])
  @@map("verification_runs")
}

// M07 owns dispute orchestration. PayPal status/stage are stored verbatim and
// never mixed with the local workflow state.
model Dispute {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @map("merchant_id") @db.Uuid
  environment     String   @default("sandbox")
  paypalDisputeId String   @map("paypal_dispute_id") @db.VarChar(255)
  paypalStatus    String   @map("paypal_status") @db.VarChar(64)
  paypalStage     String   @map("paypal_stage") @db.VarChar(64)
  paypalReason    String   @map("paypal_reason") @db.VarChar(128)
  paypalOutcome   String?  @map("paypal_outcome") @db.VarChar(64)
  reasonCategory  String   @map("reason_category") @db.VarChar(32)
  internalState   String   @default("DETECTED") @map("internal_state") @db.VarChar(32)
  currencyCode    String?  @map("currency_code") @db.VarChar(3)
  amount          Decimal? @db.Decimal(24, 8)
  disputedAt      DateTime @map("disputed_at") @db.Timestamptz(3)
  deadlineAt      DateTime? @map("deadline_at") @db.Timestamptz(3)
  lastEventAt     DateTime @map("last_event_at") @db.Timestamptz(3)
  transactionId   String?  @map("transaction_id") @db.Uuid
  linkStatus      String   @default("UNLINKED") @map("link_status") @db.VarChar(16)
  linkReason      String?  @map("link_reason") @db.VarChar(64)
  sourceEventId   String   @unique @map("source_event_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  sourceEvent WebhookEvent  @relation("DisputeSourceEvent", fields: [sourceEventId], references: [id], onDelete: Restrict)
  events      DisputeEvent[]
  submissions Submission[]
  mediationCase MediationCase?

  @@unique([merchantId, environment, paypalDisputeId])
  @@index([merchantId, disputedAt, id])
  @@index([merchantId, internalState, disputedAt])
  @@map("disputes")
}

model DisputeEvent {
  id            String   @id @default(uuid()) @db.Uuid
  disputeId     String   @map("dispute_id") @db.Uuid
  eventId       String   @unique @map("event_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(128)
  paypalEventId String   @map("paypal_event_id") @db.VarChar(255)
  outcome       String   @default("APPLIED") @db.VarChar(32)
  reason        String?  @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  dispute Dispute      @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  event   WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([disputeId, occurredAt, id])
  @@map("dispute_events")
}

// M08 owns submission orchestration. Evidence is only sent to PayPal when
// the deterministic Submission Guard approves and the merchant has authorised.
model Submission {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @map("merchant_id") @db.Uuid
  disputeId       String   @map("dispute_id") @db.Uuid
  environment     String   @default("sandbox")
  paypalRequestId String?  @map("paypal_request_id") @db.VarChar(255)
  status          String   @default("BLOCKED") @map("status") @db.VarChar(16)
  paypalResponseStatus Int?  @map("paypal_response_status")
  submittedAt     DateTime? @map("submitted_at")
  errorCode       String?  @map("error_code") @db.VarChar(80)
  errorMessage    String?  @map("error_message") @db.VarChar(2000)
  guardVerdict    String   @map("guard_verdict") @db.VarChar(16)
  guardReasons    Json     @map("guard_reasons")
  idempotencyKey  String   @unique @map("idempotency_key") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  dispute    Dispute    @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  events     SubmissionEvent[]

  @@unique([merchantId, disputeId])
  @@index([merchantId, createdAt, id])
  @@map("submissions")
}

model SubmissionEvent {
  id            String   @id @default(uuid()) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  eventId       String   @unique @map("event_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(128)
  paypalEventId String   @map("paypal_event_id") @db.VarChar(255)
  outcome       String   @default("APPLIED") @db.VarChar(32)
  reason        String?  @db.VarChar(64)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  event      WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([submissionId, occurredAt, id])
  @@map("submission_events")
}

// --- M04: ERP Integraciones (PayPalAudito) ---

// Conexión de un merchant a un ERP o sistema contable autorizado.
model ErpConnection {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  provider          String   @map("provider") @db.VarChar(64) // bind, siigo-mx, odoo, erpnext, ...
  externalTenantId  String?  @map("external_tenant_id") @db.VarChar(255)
  baseUrl           String?  @map("base_url") @db.VarChar(1024)
  status            String   @map("status") @db.VarChar(32) // pending_authorization | connected | syncing | restricted_permissions | needs_reauth | rate_limited | error | disconnected
  scopes            String?  @map("scopes") @db.VarChar(1024)
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastSyncError     String?  @map("last_sync_error") @db.VarChar(1024)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  secret     ErpSecret?
  cursors    ErpSyncCursor[]
  records    ExternalRecord[]

  @@index([merchantId, provider])
  @@map("erp_connections")
}

// Credenciales cifradas de una conexión ERP. Nunca se exponen al frontend.
model ErpSecret {
  id              String   @id @default(uuid()) @db.Uuid
  connectionId    String   @unique @map("connection_id") @db.Uuid
  encryptedPayload String @map("encrypted_payload") // JSON cifrado con API key/token, fechas de expiración, etc.
  keyVersion      Int      @default(1) @map("key_version")
  rotatedAt       DateTime @default(now()) @map("rotated_at") @db.Timestamptz(3)

  connection ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("erp_secrets")
}

// Cursor de sincronización incremental por recurso y conexión.
model ErpSyncCursor {
  id             String   @id @default(uuid()) @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  resource       String   @map("resource") @db.VarChar(64) // sales_orders | invoices | payments | shipments | customers
  cursor         String?  @map("cursor") @db.VarChar(1024)
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastError      String?  @map("last_error") @db.VarChar(1024)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resource])
  @@map("erp_sync_cursors")
}

// Registros normalizados extraídos de un ERP, listos para conciliar con PayPal.
model ExternalRecord {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  connectionId      String   @map("connection_id") @db.Uuid
  recordType        String   @map("record_type") @db.VarChar(64) // sales_order | invoice | payment | shipment | customer
  externalId        String   @map("external_id") @db.VarChar(255)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)
  normalizedPayload Json     @map("normalized_payload")
  sourceHash        String   @map("source_hash") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  connection  ErpConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactionLinks TransactionLink[]

  @@unique([connectionId, recordType, externalId])
  @@index([merchantId, recordType, externalId])
  @@map("external_records")
}

// Conciliación trazable entre una captura PayPal y un registro de ERP.
model TransactionLink {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @map("merchant_id") @db.Uuid
  paypalCaptureId  String   @map("paypal_capture_id") @db.VarChar(255)
  paypalOrderId    String?  @map("paypal_order_id") @db.VarChar(255)
  recordId         String   @map("record_id") @db.Uuid
  matchMethod      String   @map("match_method") @db.VarChar(64) // invoice_id_exact | custom_id_exact | corroborated | suggested
  confidence       String   @map("confidence") @db.VarChar(16) // high | medium | low
  reviewedBy       String?  @map("reviewed_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  record   ExternalRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@unique([merchantId, paypalCaptureId, recordId])
  @@index([merchantId, paypalCaptureId])
  @@map("transaction_links")
}

// Shipment tracking owns its jobs, observations, registration leases and budgets.
model ShipmentTrackingJob {
  transactionId String @id @map("transaction_id") @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  input Json @default("{}")
  status String @default("PENDING")
  attempts Int @default(0)
  failures Int @default(0)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  nextAttemptAt DateTime? @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastDisputeEventAt DateTime? @map("last_dispute_event_at") @db.Timestamptz(3)
  sourceAttempts Json @default("[]") @map("source_attempts")
  providerAccountKey String? @map("provider_account_key") @db.VarChar(64)
  errorCode String? @map("error_code") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  transaction Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Cascade)
  @@unique([transactionId, merchantId])
  @@index([merchantId, nextAttemptAt])
  @@map("shipment_tracking_jobs")
}

model ShipmentTrackingSnapshot {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  source String
  trackingNumber String @map("tracking_number") @db.VarChar(100)
  carrierKey String @map("carrier_key") @db.VarChar(255)
  contentHash String @map("content_hash") @db.VarChar(64)
  observation Json
  original Json
  evidenceId String? @map("evidence_id") @db.Uuid
  retrievedAt DateTime @default(now()) @map("retrieved_at") @db.Timestamptz(3)
  transaction Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Cascade)
  @@unique([transactionId, source, trackingNumber, carrierKey, contentHash])
  @@index([merchantId, transactionId, retrievedAt])
  @@map("shipment_tracking_snapshots")
}

model TrackingRegistration {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  accountKey String @map("account_key") @db.VarChar(64)
  trackingNumber String @map("tracking_number") @db.VarChar(100)
  requestedCarrier Int @default(0) @map("requested_carrier")
  parametersHash String? @map("parameters_hash") @db.VarChar(64)
  carrier Int?
  origin Int?
  status String @default("NEW")
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  lastResult Json? @map("last_result")
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  failures Int @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  errorCode String? @map("error_code") @db.VarChar(128)
  providerCode Int? @map("provider_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([merchantId, accountKey, trackingNumber, requestedCarrier])
  @@index([accountKey, trackingNumber, carrier])
  @@map("tracking_registrations")
}

model TrackingUsage {
  merchantId String @map("merchant_id") @db.Uuid
  day String @db.VarChar(10)
  requests Int @default(0)
  registrationAttempts Int @default(0) @map("registration_attempts")
  registrations Int @default(0)
  queries Int @default(0)
  failures Int @default(0)
  webhooks Int @default(0)
  @@id([merchantId, day])
  @@map("tracking_usage")
}

model TrackingApiGate {
  accountKey String @id @map("account_key") @db.VarChar(64)
  nextRequestAt DateTime @map("next_request_at") @db.Timestamptz(3)
  @@map("tracking_api_gates")
}

// Mediation owns these records; references to other modules are read-only IDs.
model MediationPolicy {
  merchantId String @id @map("merchant_id") @db.Uuid
  record Json
  updatedBy String @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "mediation_policy_merchant_fkey")
  @@map("mediation_policies")
}

model MediationCase {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  disputeId String @unique @map("dispute_id") @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  state String @default("detectado")
  policy Json
  conciliationDeadline DateTime @map("conciliation_deadline") @db.Timestamptz(3)
  claimDeadline DateTime @map("claim_deadline") @db.Timestamptz(3)
  evidenceDeadline DateTime? @map("evidence_deadline") @db.Timestamptz(3)
  paypalDeadline DateTime @map("paypal_deadline") @db.Timestamptz(3)
  detection Json?
  proposal Json?
  sellerAccepted Int? @map("seller_accepted")
  buyerAccepted Int? @map("buyer_accepted")
  verdict Json?
  packet Json?
  evidenceRevision Int? @map("evidence_revision")
  demandBy String? @map("demand_by")
  humanReviewReason String? @map("human_review_reason") @db.VarChar(128)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  failures Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  events MediationTransition[]
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "mediation_merchant_dispute_fkey")
  @@index([merchantId, state, nextAttemptAt])
  @@map("mediation_cases")
}

model MediationTransition {
  id String @id @default(uuid()) @db.Uuid
  caseId String @map("case_id") @db.Uuid
  from String?
  to String
  agent String @db.VarChar(64)
  reason String @db.VarChar(256)
  at DateTime @default(now()) @db.Timestamptz(3)
  mediationCase MediationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@index([caseId, at, id])
  @@map("mediation_transitions")
}

model MediationMessage {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  disputeId String @map("dispute_id") @db.Uuid
  sourceKey String @map("source_key") @db.VarChar(128)
  author String @db.VarChar(16)
  text String
  status String @default("QUEUED") @db.VarChar(16)
  kind String @default("MESSAGE") @db.VarChar(32)
  requestHash String @map("request_hash") @db.VarChar(64)
  actorUserId String? @map("actor_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([merchantId, disputeId, sourceKey])
  @@index([merchantId, disputeId, createdAt, id])
  @@map("mediation_messages")
}

model MediationAction {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  disputeId String @map("dispute_id") @db.Uuid
  key String @db.VarChar(128)
  hash String @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([merchantId, disputeId, key])
  @@map("mediation_actions")
}

model MediationDelivery {
  id String @id @default(uuid()) @db.Uuid
  caseId String @unique @map("case_id") @db.Uuid
  status String @default("QUEUED") @db.VarChar(16)
  phase String @default("EVIDENCE") @db.VarChar(16)
  payloadHash String @map("payload_hash") @db.VarChar(64)
  errorCode String? @map("error_code") @db.VarChar(128)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("mediation_deliveries")
}

// M01: identifiers and consent only. Platform secrets remain in server configuration.
model PayPalAccount {
  merchantId String    @id @map("merchant_id") @db.Uuid
  sellerId   String?   @unique @map("seller_id") @db.VarChar(13)
  trackingId String    @unique @map("tracking_id") @db.Uuid
  status     String    @default("PENDING") @db.VarChar(24)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  checkedAt  DateTime? @map("checked_at") @db.Timestamptz(3)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("paypal_accounts")
}

model ConciliationPolicy {
  merchantId String @id @map("merchant_id") @db.Uuid
  settings Json
  version Int @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  @@map("conciliation_policies")
}

model ConciliationChat {
  id String @id @default(uuid()) @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  orderId String? @map("order_id") @db.Uuid
  transactionId String? @map("transaction_id") @db.Uuid
  orderReference String @map("order_reference") @db.VarChar(255)
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  state String @default("WAITING") @db.VarChar(24)
  category String @default("OTHER") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  messages ConciliationMessage[]
  @@unique([id, merchantId])
  @@index([merchantId, updatedAt, id])
  @@map("conciliation_chats")
}

model ConciliationMessage {
  id String @id @default(uuid()) @db.Uuid
  chatId String @map("chat_id") @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  author String @db.VarChar(16)
  sequence Int
  text String @db.VarChar(2000)
  language String @db.VarChar(2)
  idempotencyKey String @map("idempotency_key") @db.Uuid
  responseToId String? @unique @map("response_to_id") @db.Uuid
  classification Json?
  draftText String? @map("draft_text") @db.VarChar(1500)
  plan String? @db.VarChar(1000)
  draftStatus String @default("NONE") @map("draft_status") @db.VarChar(24)
  version Int @default(0)
  policyVersion Int? @map("policy_version")
  policySnapshot Json? @map("policy_snapshot")
  approvedBy String? @map("approved_by") @db.Uuid
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  chat ConciliationChat @relation(fields: [chatId, merchantId], references: [id, merchantId], onDelete: Restrict)
  @@unique([chatId, author, idempotencyKey])
  @@unique([chatId, sequence])
  @@index([merchantId, createdAt])
  @@index([chatId, createdAt, id])
  @@map("conciliation_messages")
}
