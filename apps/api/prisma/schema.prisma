generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Minimal merchant identity anchor. M01 will own its integration and authorization.
model Merchant {
  id                      String               @id @default(uuid()) @db.Uuid
  displayName             String               @map("display_name")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  allowInvestigations     Boolean              @default(false) @map("allow_investigations")
  allowSubmissions        Boolean              @default(false) @map("allow_submissions")
  requireMerchantApproval Boolean              @default(true) @map("require_merchant_approval")
  members                 MerchantMember[]
  integration             MerchantIntegration?
  events                  MerchantEvent[]
  webhookEvents           WebhookEvent[]
  transactions            Transaction[]
  orders                  MerchantOrder[]
  dossiers                EvidenceDossier[]
  investigations          InvestigationRun[]
  orderSources            OrderSourceJob[]

  @@map("merchants")
}

enum MerchantRole {
  ADMIN
  VIEWER
}

model MerchantMember {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @map("merchant_id") @db.Uuid
  authUserId String       @unique @map("auth_user_id") @db.Uuid
  role       MerchantRole @default(VIEWER)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("merchant_members")
}

model MerchantIntegration {
  merchantId            String   @id @map("merchant_id") @db.Uuid
  connectionStatus      String   @map("connection_status")
  disputesReadStatus    String   @map("disputes_read_status")
  credentialFingerprint String   @map("credential_fingerprint")
  lastCheckedAt         DateTime @map("last_checked_at") @db.Timestamptz(3)
  paypalHttpStatus      Int?     @map("paypal_http_status")
  paypalDebugId         String?  @map("paypal_debug_id")
  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("merchant_integrations")
}

model MerchantEvent {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  details     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, createdAt])
  @@map("merchant_events")
}

model WebhookEvent {
  id             String        @id @default(uuid()) @db.Uuid
  merchantId     String        @map("merchant_id") @db.Uuid
  environment    String        @default("sandbox")
  paypalEventId  String        @map("paypal_event_id") @db.VarChar(255)
  eventType      String        @map("event_type") @db.VarChar(128)
  eventCreatedAt DateTime      @map("event_created_at") @db.Timestamptz(3)
  webhookId      String        @map("webhook_id")
  transmissionId String        @map("transmission_id")
  payload        Json
  rawBody        String        @map("raw_body")
  payloadHash    String        @map("payload_hash") @db.VarChar(64)
  rawBodyHash    String        @map("raw_body_hash") @db.VarChar(64)
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  job            IngestionJob?
  transaction    Transaction?

  @@unique([merchantId, environment, paypalEventId])
  @@index([merchantId, receivedAt])
  @@map("webhook_events")
}

model IngestionJob {
  id         String       @id @default(uuid()) @db.Uuid
  eventId    String       @unique @map("event_id") @db.Uuid
  kind       String
  status     String       @default("QUEUED")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)
  errorCode  String?      @map("error_code") @db.VarChar(64)
  event      WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("ingestion_jobs")
}

// M03 owns captured payments. References are not merchant order documents.
model Transaction {
  id                     String   @id @default(uuid()) @db.Uuid
  merchantId             String   @map("merchant_id") @db.Uuid
  environment            String   @default("sandbox")
  paypalCaptureId        String   @map("paypal_capture_id") @db.VarChar(255)
  paypalOrderId          String?  @map("paypal_order_id") @db.VarChar(255)
  merchantOrderReference String?  @map("merchant_order_reference") @db.VarChar(255)
  invoiceId              String?  @map("invoice_id") @db.VarChar(255)
  status                 String   @default("COMPLETED")
  currencyCode           String   @map("currency_code") @db.VarChar(3)
  amount                 Decimal  @db.Decimal(24, 8)
  capturedAt             DateTime @map("captured_at") @db.Timestamptz(3)
  sourceEventId          String   @unique @map("source_event_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  merchantOrderId        String?  @unique @map("merchant_order_id") @db.Uuid
  orderLinkError         String?  @map("order_link_error") @db.VarChar(64)

  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sourceEvent    WebhookEvent       @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  merchantOrder  MerchantOrder?     @relation(fields: [merchantOrderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  dossier        EvidenceDossier?
  investigations InvestigationRun[]
  orderSources   OrderSourceJob[]

  @@unique([merchantId, environment, paypalCaptureId])
  @@unique([merchantOrderId, merchantId])
  @@unique([id, merchantId])
  @@index([merchantId, createdAt, id])
  @@map("transactions")
}

model MerchantOrder {
  id             String       @id @default(uuid()) @db.Uuid
  merchantId     String       @map("merchant_id") @db.Uuid
  environment    String       @default("sandbox")
  externalId     String       @map("external_id") @db.VarChar(255)
  paypalOrderId  String?      @map("paypal_order_id") @db.VarChar(255)
  sourceKind     String       @map("source_kind")
  sourceSystem   String       @map("source_system") @db.VarChar(255)
  currencyCode   String       @map("currency_code") @db.VarChar(3)
  totalAmount    Decimal      @map("total_amount") @db.Decimal(24, 8)
  shippingAmount Decimal      @map("shipping_amount") @db.Decimal(24, 8)
  taxAmount      Decimal      @map("tax_amount") @db.Decimal(24, 8)
  discountAmount Decimal      @map("discount_amount") @db.Decimal(24, 8)
  orderedAt      DateTime     @map("ordered_at") @db.Timestamptz(3)
  items          Json
  contentHash    String       @map("content_hash") @db.VarChar(64)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction    Transaction?

  @@unique([merchantId, environment, externalId])
  @@unique([id, merchantId])
  @@unique([merchantId, environment, paypalOrderId])
  @@index([merchantId, createdAt, id])
  @@map("merchant_orders")
}

model EvidenceDossier {
  id            String         @id @default(uuid()) @db.Uuid
  merchantId    String         @map("merchant_id") @db.Uuid
  transactionId String         @unique @map("transaction_id") @db.Uuid
  revision      Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction   Transaction    @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  items         EvidenceItem[]

  @@unique([transactionId, merchantId])
  @@index([merchantId])
  @@map("evidence_dossiers")
}

model EvidenceItem {
  id                String          @id @default(uuid()) @db.Uuid
  dossierId         String          @map("dossier_id") @db.Uuid
  type              String
  logicalKey        String          @map("logical_key") @db.VarChar(64)
  version           Int
  sourceKind        String          @map("source_kind")
  sourceSystem      String          @map("source_system") @db.VarChar(255)
  externalReference String          @map("external_reference") @db.VarChar(255)
  retrievedAt       DateTime        @map("retrieved_at") @db.Timestamptz(3)
  content           Json
  contentHash       String          @map("content_hash") @db.VarChar(64)
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  dossier           EvidenceDossier @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  @@unique([dossierId, version])
  @@index([dossierId, logicalKey, version])
  @@map("evidence_items")
}

// M05 owns investigations; evidence originals remain owned by M04.
model InvestigationRun {
  id               String      @id @default(uuid()) @db.Uuid
  merchantId       String      @map("merchant_id") @db.Uuid
  transactionId    String      @map("transaction_id") @db.Uuid
  idempotencyKey   String      @map("idempotency_key") @db.Uuid
  actorUserId      String      @map("actor_user_id") @db.Uuid
  status           String      @default("RUNNING")
  provider         String
  model            String      @db.VarChar(128)
  promptVersion    String      @map("prompt_version") @db.VarChar(64)
  evidenceRevision Int         @map("evidence_revision")
  snapshot         Json
  snapshotHash     String      @map("snapshot_hash") @db.VarChar(64)
  result           Json?
  resultHash       String?     @map("result_hash") @db.VarChar(64)
  trace            Json
  usage            Json
  errorCode        String?     @map("error_code") @db.VarChar(80)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(3)
  finishedAt       DateTime?   @map("finished_at") @db.Timestamptz(3)
  merchant         Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction      Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([merchantId, transactionId, idempotencyKey], map: "investigation_runs_merchant_id_transaction_id_idempotency_key_k")
  @@index([merchantId, transactionId, createdAt])
  @@map("investigation_runs")
}

// M03 owns source work and normalized current data; M04 owns original history.
model OrderSourceJob {
  id              String      @id @default(uuid()) @db.Uuid
  merchantId      String      @map("merchant_id") @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  providerId      String      @map("provider_id") @db.VarChar(64)
  sourceKind      String      @map("source_kind")
  sourceSystem    String      @map("source_system") @db.VarChar(255)
  status          String      @default("PENDING")
  attempts        Int         @default(0)
  leaseToken      String?     @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime?   @map("lease_expires_at") @db.Timestamptz(3)
  nextAttemptAt   DateTime?   @map("next_attempt_at") @db.Timestamptz(3)
  lastCheckedAt   DateTime?   @map("last_checked_at") @db.Timestamptz(3)
  lastSucceededAt DateTime?   @map("last_succeeded_at") @db.Timestamptz(3)
  errorCode       String?     @map("error_code") @db.VarChar(128)
  httpStatus      Int?        @map("http_status")
  evidenceId      String?     @map("evidence_id") @db.Uuid
  normalized      Json?
  contentHash     String?     @map("content_hash") @db.VarChar(64)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant        Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transaction     Transaction @relation(fields: [transactionId, merchantId], references: [id, merchantId], onDelete: Cascade)

  @@unique([transactionId, providerId])
  @@index([merchantId, status, nextAttemptAt])
  @@map("order_source_jobs")
}
