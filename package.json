{
  "name": "resolve-ai-backend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @resolve-ai/contracts build && pnpm --filter @resolve-ai/api dev",
    "build": "pnpm --filter @resolve-ai/contracts build && pnpm --filter @resolve-ai/api build",
    "start": "pnpm --filter @resolve-ai/api start",
    "start:render": "pnpm --filter @resolve-ai/api start:render",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @resolve-ai/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @resolve-ai/contracts build && vitest run",
    "test:db": "pnpm --filter @resolve-ai/contracts build && vitest run --config vitest.db.config.ts",
    "db:generate": "pnpm --filter @resolve-ai/api exec prisma generate",
    "db:validate": "pnpm --filter @resolve-ai/api exec prisma validate",
    "db:migrate": "pnpm --filter @resolve-ai/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @resolve-ai/api exec prisma migrate deploy",
    "merchant:setup": "pnpm --filter @resolve-ai/api exec tsx --tsconfig tsconfig.json src/commands/setup-merchant.ts",
    "storage:setup": "pnpm --filter @resolve-ai/api exec tsx --tsconfig tsconfig.json src/commands/setup-evidence-storage.ts",
    "check": "pnpm db:generate && pnpm db:validate && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "jose": "6.2.15",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0",
    "dotenv": "^17.0.0"
  }
}
