{
  "detectorOutput": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "tipo": {
        "type": "string",
        "enum": [
          "DEFECTIVE_OR_NOT_AS_DESCRIBED",
          "REFUND_REQUEST",
          "SHIPPING_ERROR"
        ]
      },
      "gravedad": {
        "type": "string",
        "enum": ["LOW", "MEDIUM", "HIGH"]
      },
      "resumen": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "confianza": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "case_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "order_id": {
        "type": "string",
        "minLength": 1
      },
      "paypal_transaction_id": {
        "type": "string",
        "minLength": 1
      },
      "origen": {
        "type": "string",
        "enum": ["auto", "manual"]
      },
      "reportante": {
        "type": "string",
        "enum": ["cliente", "vendedor"]
      },
      "monto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "currencyCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": ["value", "currencyCode"],
        "additionalProperties": false
      }
    },
    "required": [
      "tipo",
      "gravedad",
      "resumen",
      "confianza",
      "case_id",
      "order_id",
      "paypal_transaction_id",
      "origen",
      "reportante",
      "monto"
    ],
    "additionalProperties": false
  },
  "detection": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "complaint": {
        "type": "boolean"
      },
      "type": {
        "type": "string",
        "enum": [
          "DEFECTIVE_OR_NOT_AS_DESCRIBED",
          "REFUND_REQUEST",
          "SHIPPING_ERROR"
        ]
      },
      "severity": {
        "type": "string",
        "enum": ["LOW", "MEDIUM", "HIGH"]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "humanReview": {
        "type": "boolean"
      }
    },
    "required": [
      "complaint",
      "type",
      "severity",
      "summary",
      "confidence",
      "humanReview"
    ],
    "additionalProperties": false
  },
  "proposal": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "options": {
        "minItems": 1,
        "maxItems": 5,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "solution": {
              "type": "string",
              "enum": [
                "REPLACEMENT",
                "RESHIPMENT",
                "PARTIAL_DISCOUNT",
                "STORE_CREDIT",
                "FULL_REFUND_RECOMMENDATION"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": ["solution", "description"],
          "additionalProperties": false
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "notice": {
        "type": "string",
        "const": "La mediación sigue las políticas del negocio. La plataforma no mueve, retiene ni reembolsa dinero; PayPal toma la decisión financiera final."
      },
      "humanReview": {
        "type": "boolean"
      }
    },
    "required": ["options", "summary", "notice", "humanReview"],
    "additionalProperties": false
  },
  "verdict": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "recommendation": {
        "type": "string",
        "enum": ["BUYER", "SELLER", "PARTIAL"]
      },
      "evidenceBalance": {
        "type": "string",
        "enum": ["EQUIVALENT", "CLEAR_BUYER", "CLEAR_SELLER", "MIXED"]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "grounds": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidenceIds": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "required": ["statement", "evidenceIds"],
          "additionalProperties": false
        }
      },
      "assessedEvidence": {
        "minItems": 1,
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "evidenceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "assessment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": ["evidenceId", "assessment"],
          "additionalProperties": false
        }
      },
      "notice": {
        "type": "string",
        "const": "La mediación sigue las políticas del negocio. La plataforma no mueve, retiene ni reembolsa dinero; PayPal toma la decisión financiera final."
      },
      "humanReview": {
        "type": "boolean"
      }
    },
    "required": [
      "recommendation",
      "evidenceBalance",
      "summary",
      "grounds",
      "assessedEvidence",
      "notice",
      "humanReview"
    ],
    "additionalProperties": false
  },
  "independentReview": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "approved": {
        "type": "boolean"
      },
      "reasons": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "evidenceIds": {
        "minItems": 1,
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "required": ["approved", "reasons", "evidenceIds"],
    "additionalProperties": false
  },
  "messageInput": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "idempotencyKey": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "required": ["idempotencyKey", "text"],
    "additionalProperties": false
  },
  "startInput": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "idempotencyKey": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "origin": {
        "type": "string",
        "enum": ["auto", "manual"]
      },
      "confirmed": {
        "default": false,
        "type": "boolean"
      },
      "type": {
        "type": "string",
        "enum": [
          "DEFECTIVE_OR_NOT_AS_DESCRIBED",
          "REFUND_REQUEST",
          "SHIPPING_ERROR"
        ]
      }
    },
    "required": ["idempotencyKey", "origin", "confirmed"],
    "additionalProperties": false
  },
  "actionInput": {
