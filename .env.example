# Copy to .env in the repository root. Never commit real credentials.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolve_ai?schema=public
# Direct or session-mode connection for migrations (Supabase: not transaction pooler).
# Supabase TLS: append sslmode=verify-full and sslrootcert=<encoded absolute CA path>.
# Download the official CA from Database Settings; see docs/m01-merchants.md.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/resolve_ai?schema=public
DB_CONNECTION_TIMEOUT_MS=3000
SWAGGER_ENABLED=true

# M01: one merchant. Generate a UUID once; keep it stable.
MERCHANT_ID=
# Supabase Auth project origin; use asymmetric signing keys (ES256/RS256).
SUPABASE_URL=
# Optional public client key for frontend/login verification; not required by JWT verification.
SUPABASE_PUBLISHABLE_KEY=

# M01: server-only PayPal Sandbox credentials. Configure both or neither.
PAYPAL_ENV=sandbox
# Approved PayPal partner onboarding (optional; no simulated connection if absent).
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_ONBOARDING_RETURN_URL=http://localhost:3000/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=5000

# M03: defaults to true in production, false in development/test. Explicit override.
# M07 reuses the same opt-in unless DISPUTE_WORKER_ENABLED overrides it.
TRANSACTION_WORKER_ENABLED=false
DISPUTE_WORKER_ENABLED=false

# M04: server-only Storage credentials. Provision a private bucket before use.
# Without the key, structured evidence works; binary upload/download returns 503.
# Recommended current backend key. Never put it in a browser or Git.
SUPABASE_SECRET_KEY=
# Legacy JWT fallback, used only when SUPABASE_SECRET_KEY is absent.
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=private-evidence

# M05: configure the selected provider only. No automatic provider fallback.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
OPENAI_API_KEY=
OPENAI_MODEL=
INVESTIGATOR_MAX_STEPS=8
INVESTIGATOR_TIMEOUT_MS=60000
# Reserved for M06/M07 investigation retry cycles, not the M05 tool step budget.
MAX_INVESTIGATION_ROUNDS=2

# Independent M06 review; same selected provider, separate context and budget.
VERIFIER_MAX_STEPS=12
VERIFIER_TIMEOUT_MS=90000

# Shipment tracking: PayPal -> connected ERP -> 17TRACK v2.4 fallback.
# Server-only token. No provider calls are possible without a configured key.
SEVENTEENTRACK_API_KEY=
SEVENTEENTRACK_TIMEOUT_MS=10000

# Encryption: master key for per-merchant ERP secrets (XChaCha20-Poly1305 via libsodium)
# Generate once: node -e "require('libsodium-wrappers').ready.then(s => console.log(s.to_base64(s.randombytes_buf(32))))"
# Store in Render as Encrypted Environment Variable. Never commit.
MASTER_ENCRYPTION_KEY=
# Set the public /api/webhooks/17track URL in the 17TRACK dashboard before enabling.
SEVENTEENTRACK_WEBHOOK_ENABLED=false
# Conservative limits per merchant and UTC day; 0 disables that category.
SEVENTEENTRACK_DAILY_REGISTRATION_LIMIT=100
SEVENTEENTRACK_DAILY_REQUEST_LIMIT=1000
# Explicit opt-in for the durable tracking worker; independent of optional pg-boss.
SHIPMENT_TRACKING_WORKER_ENABLED=false
SHIPMENT_TRACKING_CACHE_SECONDS=21600
SHIPMENT_TRACKING_FRESH_HOURS=72

# Mediation: only existing PayPal disputes. Configure each business policy via API.
# Enable after applying the mediation migration. Normal cases run automatically.
MEDIATION_WORKER_ENABLED=false
# Maximum new mediation candidates per merchant/minute; existing cases are idempotent.
MEDIATION_DETECTION_PER_MINUTE=30
