# Copy to .env in the repository root. Never commit real credentials.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolve_ai?schema=public
# Direct or session-mode connection for migrations (Supabase: not transaction pooler).
# Supabase TLS: append sslmode=verify-full and sslrootcert=<encoded absolute CA path>.
# Download the official CA from Database Settings; see docs/m01-merchants.md.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/resolve_ai?schema=public
DB_CONNECTION_TIMEOUT_MS=3000
SWAGGER_ENABLED=true

# M01: one merchant. Generate a UUID once; keep it stable.
MERCHANT_ID=
# Supabase Auth project origin; use asymmetric signing keys (ES256/RS256).
SUPABASE_URL=
# Optional public client key for frontend/login verification; not required by JWT verification.
SUPABASE_PUBLISHABLE_KEY=

# M01: server-only PayPal Sandbox credentials. Configure both or neither.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=5000

# Reserved for future modules.
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=private-evidence
MAX_INVESTIGATION_ROUNDS=2
